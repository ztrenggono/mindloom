# Copy to .env to change any of these. Everything works without a .env file.

# Port for the web app on your machine: http://localhost:8080
WEB_PORT=8080

# Database credentials. Change the password before exposing the stack beyond your machine.
POSTGRES_USER=mindloom
POSTGRES_PASSWORD=mindloom
POSTGRES_DB=mindloom

# Shared secret for the sync API. When set, each browser asks for it once (click the save status in
# the bottom bar). Set it before exposing the stack beyond your machine: openssl rand -hex 32
API_TOKEN=

# HTTPS with Caddy (optional). Uncomment these to turn it on, then `docker compose up -d`.
# DOMAIN is what people type in the browser: a hostname (mindloom.office.lan) or the server's IP.
# TLS=internal uses Caddy's own certificate authority (office network, no public domain; see README).
# For a public domain pointing at this server, set TLS to your email for a Let's Encrypt certificate.
# COMPOSE_PROFILES=https
# DOMAIN=mindloom.office.lan
# TLS=internal
# Keep plain HTTP on port 8080 to this machine only, so the token never crosses the network unencrypted.
# WEB_PORT=127.0.0.1:8080
# HTTP_PORT=80
# HTTPS_PORT=443
