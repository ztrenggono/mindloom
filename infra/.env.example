# Copy to .env to change any of these. Everything works without a .env file.

# Port for the web app on your machine: http://localhost:8080
WEB_PORT=8080

# Database credentials. Change the password before exposing the stack beyond your machine.
POSTGRES_USER=mindloom
POSTGRES_PASSWORD=mindloom
POSTGRES_DB=mindloom

# Shared secret for the sync API. When set, each browser asks for it once (click the save status in
# the bottom bar). Set it before exposing the stack beyond your machine: openssl rand -hex 32
API_TOKEN=
