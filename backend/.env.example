DATABASE_URL=postgres://mindloom:mindloom@localhost:5432/mindloom
PORT=8787
# Comma-separated origins allowed to call the API directly (the Vite dev server uses a proxy instead).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Shared secret the frontend sends as "Authorization: Bearer <token>". Leave empty only on a machine
# nobody else can reach. Generate one with: openssl rand -hex 32
API_TOKEN=
